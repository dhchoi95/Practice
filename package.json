{
  "name": "restaurant-ops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "node scripts/prisma-wasm.cjs generate",
    "db:migrate": "node scripts/prisma-wasm.cjs create",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "db:migrate:deploy": "node scripts/prisma-wasm.cjs deploy",
    "test:e2e": "python scripts/prepare-test-env.py && playwright test",
    "db:validate": "node scripts/prisma-wasm.cjs validate",
    "db:format": "node scripts/prisma-wasm.cjs format",
    "db:migrate:status": "node scripts/prisma-wasm.cjs status"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "next": "16.4.0",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@prisma/client-generator-registry": "7.10.0",
    "@prisma/internals": "7.10.0",
    "@prisma/migrate": "7.10.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^18.0.6",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  }
}
