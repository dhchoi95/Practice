{
  "name": "haru-saju",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "npm run content:validate && npm run content:evaluate && next build --webpack && npm run content:build-policy",
    "start": "node scripts/serve.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content:validate": "tsx scripts/content-tools.ts validate",
    "content:coverage": "tsx scripts/content-tools.ts coverage",
    "content:preview": "tsx scripts/content-tools.ts preview",
    "content:lint": "tsx scripts/content-tools.ts lint",
    "content:evaluate": "node --import tsx scripts/evaluate-content.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run content:lint && npm run content:coverage && npm run content:evaluate && npm run content:review && npm run content:assembled && npm run content:compound && npm run content:editorial && npm run content:integrated && npm run content:foundation",
    "content:review": "node --import tsx scripts/review-content.ts",
    "content:assembled": "node --import tsx scripts/evaluate-assembled.ts",
    "content:compound": "node --import tsx scripts/preview-compound.ts",
    "content:build-policy": "node scripts/verify-static-content.mjs",
    "content:editorial": "node --import tsx scripts/audit-editorial.ts",
    "content:record": "node --import tsx scripts/record-editorial-review.ts",
    "content:integrated": "node --import tsx scripts/check-integrated.ts",
    "content:foundation": "node --import tsx scripts/check-foundation.ts"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "korean-lunar-calendar": "0.4.0",
    "lunar-typescript": "1.8.6",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astronomy-engine": "2.1.19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "lighthouse": "13.5.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
