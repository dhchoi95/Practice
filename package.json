{
  "name": "haru-saju",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "npm run content:validate && next build --webpack",
    "start": "node scripts/serve.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content:validate": "tsx scripts/content-tools.ts validate",
    "content:coverage": "tsx scripts/content-tools.ts coverage",
    "content:preview": "tsx scripts/content-tools.ts preview",
    "content:lint": "tsx scripts/content-tools.ts lint",
    "verify": "npm run lint && npm run typecheck && npm test && npm run content:lint && npm run content:coverage"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "korean-lunar-calendar": "0.4.0",
    "lunar-typescript": "1.8.6",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astronomy-engine": "2.1.19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "lighthouse": "13.5.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
